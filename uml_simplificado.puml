@startuml
hide empty members
hide methods
hide fields
skinparam classAttributeIconSize 0
skinparam linetype ortho
left to right direction

package Modelo {
  class Juego
  class Jugador
  enum EstadoJuego
}

package "Modelo.nivel" {
  class Nivel
  class SpawnEnemigo
  class EventoEnemigoEliminado
  enum EstadoNivel
}

package "Modelo.escena" {
  class Escenario
  class Ruta
  class Base
  class Slot
}

package "Modelo.enemigo" {
  abstract class Enemigo
  class EnemigoDebil
  class EnemigoMedio
  class EnemigoFuerte
  enum TipoEnemigo
  class FabricaEnemigo
}

package "Modelo.torreta" {
  abstract class Torreta
  class TorretaSimple
  class TorretaRapida
  class TorretaPotente
  class TorretaDistante
  enum TipoTorreta
  class FabricaTorreta
}

package "Modelo.proyectil" {
  class Proyectil
}

package "Modelo.geometria" {
  class Posicion
  class Dimension
  class Caja
}

' --- Flujo principal ---
Juego o-- Jugador
Juego o-- "1..*" Nivel
Juego --> EstadoJuego

Nivel o-- Escenario
Nivel o-- Jugador
Nivel o-- "0..*" SpawnEnemigo
Nivel *-- "0..*" Enemigo
Nivel *-- "0..*" Torreta
Nivel *-- "0..*" Proyectil
Nivel *-- "0..*" EventoEnemigoEliminado
Nivel *-- FabricaEnemigo
Nivel *-- FabricaTorreta
Nivel --> EstadoNivel

' --- Escenario ---
Escenario o-- Ruta
Escenario o-- Base
Escenario o-- "0..*" Slot

' --- Enemigos ---
Enemigo <|-- EnemigoDebil
Enemigo <|-- EnemigoMedio
Enemigo <|-- EnemigoFuerte
Enemigo o-- Ruta
Enemigo --> TipoEnemigo
SpawnEnemigo --> TipoEnemigo
EventoEnemigoEliminado --> TipoEnemigo
FabricaEnemigo ..> TipoEnemigo
FabricaEnemigo ..> Enemigo

' --- Torretas y proyectiles ---
Torreta <|-- TorretaSimple
Torreta <|-- TorretaRapida
Torreta <|-- TorretaPotente
Torreta <|-- TorretaDistante
Torreta --> TipoTorreta
Torreta ..> Enemigo : busca objetivo
Torreta ..> Proyectil : crea
FabricaTorreta ..> TipoTorreta
FabricaTorreta ..> Torreta

Proyectil --> Enemigo : objetivo
Proyectil --> TipoTorreta

' --- Geometria resumida ---
Ruta o-- "2..*" Posicion
Base o-- Posicion
Slot o-- Posicion
Slot o-- Dimension
Caja o-- Posicion
Caja o-- Dimension

@enduml
